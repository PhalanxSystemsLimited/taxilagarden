---
/**
 * Typographic wordmark (the client logo file has not been supplied yet).
 * To use a real logo: put logo.svg in src/assets/images and replace the <svg> mark below with <Image>.
 */
import type { Lang } from '../../data/types';
import { getDict, routeHref } from '../../lib/i18n';

interface Props {
  lang: Lang;
  tone?: 'light' | 'dark';
  class?: string;
}
const { lang, tone = 'light', class: className = '' } = Astro.props;
const t = getDict(lang);
const dark = tone === 'dark';
const words = t.home.hero;
---

<a
  href={routeHref('home', lang)}
  class:list={['group inline-flex min-h-11 items-center gap-3', className]}
  data-logo
>
  <svg viewBox="0 0 64 64" class="h-10 w-10 shrink-0" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#1A1D17"></rect>
    <rect x="3" y="3" width="58" height="58" rx="11" fill="none" stroke="#D4A94B" stroke-opacity=".55" stroke-width="1.5"></rect>
    <g fill="#FFDF9E" class="origin-bottom transition-transform duration-700 group-hover:scale-105">
      <circle cx="32" cy="24" r="12"></circle>
      <circle cx="22" cy="30" r="8"></circle>
      <circle cx="42" cy="30" r="8"></circle>
      <rect x="30" y="30" width="4" height="20" rx="1.5"></rect>
    </g>
    <rect x="18" y="49" width="28" height="3" rx="1.5" fill="#D4A94B"></rect>
  </svg>
  <span class="flex flex-col">
    <span class:list={['font-display text-headline-sm leading-none rtl:leading-[1.7] tracking-tight whitespace-nowrap', dark ? 'text-surface-bright' : 'text-on-surface']}>
      {words.titleA}
    </span>
    <span class:list={['mt-1 font-label text-label-eyebrow uppercase leading-none rtl:leading-[1.7] whitespace-nowrap', dark ? 'text-gold-antique-light' : 'text-secondary']}>
      {words.titleB}
    </span>
  </span>
</a>
