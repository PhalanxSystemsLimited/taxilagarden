---
/** Dark call-to-action band (site tour). */
import Button from '../ui/Button.astro';
import { waLink } from '../../data/site';
import { getDict, routeHref } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title?: string;
  text?: string;
  button?: string;
}
const { lang } = Astro.props;
const t = getDict(lang);
const { eyebrow = t.amenities.ctaEyebrow, title = t.amenities.ctaTitle, text = t.amenities.ctaText, button = t.amenities.ctaButton } = Astro.props;
---

<section class="container-x py-space-2xl md:py-space-3xl">
  <div class="relative isolate overflow-hidden rounded-2xl border border-secondary-fixed/25 bg-primary-container px-space-lg py-space-2xl text-center shadow-2xl sm:px-space-2xl" data-reveal>
    <svg class="absolute inset-0 -z-10 h-full w-full text-gold-antique-light opacity-10" preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
      <path d="M0,0 C30,40 70,60 100,100 M100,0 C70,40 30,60 0,100" fill="none" stroke="currentColor" stroke-width="0.3"></path>
    </svg>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgb(212_169_75/0.18),transparent_65%)]" aria-hidden="true"></div>
    <p class="eyebrow eyebrow-center mb-3 justify-center text-secondary-fixed">{eyebrow}</p>
    <h2 class="mx-auto max-w-2xl font-display text-headline-lg-mobile text-balance text-surface-bright md:text-headline-lg" data-split>{title}</h2>
    <p class="mx-auto mt-3 max-w-xl font-body text-body-md text-surface-variant">{text}</p>
    <div class="mt-space-xl flex flex-col items-stretch justify-center gap-space-sm sm:flex-row sm:items-center sm:gap-space-md">
      <Button variant="primary" size="lg" href={routeHref('contact', lang)} inquiry magnetic icon="calendar_today">{button}</Button>
      <Button variant="whatsapp" size="lg" href={waLink()} external icon="chat">{t.common.whatsappSales}</Button>
    </div>
  </div>
</section>
