---
/** "Projects completed by Minawa Group" (from the data sheet). */
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { tl } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<ul class="grid grid-cols-1 gap-space-md sm:grid-cols-2 lg:grid-cols-3">
  {
    site.developerProjects.map((p) => (
      <li
        class="group flex items-start gap-space-md rounded-xl border border-border-sand-medium/50 bg-surface-cream-card p-space-lg transition-[border-color,box-shadow,transform] duration-500 ease-(--ease-out-expo) hover:-translate-y-1 hover:border-secondary-fixed hover:shadow-tier2"
        data-reveal
      >
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-surface-cream-highlight text-secondary transition-colors duration-500 group-hover:bg-secondary group-hover:text-white">
          <Icon name="apartment" size={22} />
        </span>
        <div>
          <h3 class="font-display text-headline-sm text-on-surface" lang="en" dir="ltr">{p.name}</h3>
          <p class="mt-0.5 flex items-center gap-1 font-body text-body-sm text-on-surface-variant">
            <Icon name="location_on" size={16} class="text-secondary" />
            {tl(p.location, lang)}
          </p>
          <p class="mt-2 inline-flex items-center gap-1 font-label text-label-badge uppercase text-nature-olive">
            <Icon name="check_circle" size={14} />
            {lang === 'ur' ? 'مکمل شدہ' : 'Completed'}
          </p>
        </div>
      </li>
    ))
  }
</ul>
