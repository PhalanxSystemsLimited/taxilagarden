---
import Icon from '../ui/Icon.astro';
import { landmarks } from '../../data/landmarks';
import { getDict, tl } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const items = landmarks.filter((l) => l.distanceKm !== null);
---

<ul class="divide-y divide-border-sand-light rounded-xl border border-border-sand-medium/60 bg-surface-cream-card px-space-md py-space-xs shadow-sm" data-reveal>
  {
    items.map((l) => (
      <li class="flex items-center justify-between gap-3 py-2.5 font-body text-body-sm">
        <span class="flex items-center gap-2 text-on-surface">
          <Icon name={l.icon} size={18} class="text-secondary" />
          {tl(l.name, lang)}
        </span>
        <span class="shrink-0 font-label text-label-badge text-secondary" dir="ltr">
          {l.distanceKm!.toFixed(1)} km
        </span>
      </li>
    ))
  }
</ul>
<p class="mt-2 font-body text-[12px] text-text-muted-dark">{t.location.mapAttributionNote}</p>
