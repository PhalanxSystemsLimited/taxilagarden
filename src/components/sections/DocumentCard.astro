---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { ApprovalDoc } from '../../data/approvals';
import { fullImage } from '../../lib/images';
import { formatDate, getDict, tl } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  doc: ApprovalDoc;
  lang: Lang;
  detailed?: boolean;
}
const { doc, lang, detailed = false } = Astro.props;
const t = getDict(lang);
const full = doc.image ? await fullImage(doc.image) : null;
const title = tl(doc.title, lang);
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-secondary-fixed/30 bg-dark-brown-elevated shadow-2xl" data-reveal>
  <!-- Scan thumbnail -> PhotoSwipe (full resolution) -->
  <div class="relative aspect-[4/3] overflow-hidden bg-surface-container sm:aspect-[16/10]">
    {
      doc.image && full ? (
        <a
          href={full.src}
          data-pswp
          data-pswp-width={doc.image.width}
          data-pswp-height={doc.image.height}
          data-caption={title}
          class="group block h-full w-full"
          aria-label={`${t.common.inspectDocument}: ${title}`}
        >
          <Image
            src={doc.image}
            alt={tl(doc.imageAlt, lang)}
            width={900}
            widths={[480, 720, 900]}
            sizes="(min-width: 1024px) 600px, 100vw"
            class="h-full w-full object-cover object-top transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-105"
            loading="lazy"
          />
          <span class="absolute inset-0 bg-gradient-to-t from-primary-container/80 via-transparent to-transparent" />
          <span class="absolute bottom-3 start-3 inline-flex items-center gap-1.5 rounded-full bg-dark-brown-surface/90 px-3 py-1.5 font-label text-label-badge uppercase text-secondary-fixed backdrop-blur">
            <Icon name="zoom_in" size={16} />
            {t.common.zoomHint}
          </span>
        </a>
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-[repeating-linear-gradient(135deg,var(--color-surface-container)_0_14px,var(--color-surface-container-high)_14px_28px)] p-6 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full border border-gold-antique-light/60 bg-surface-cream-highlight text-secondary">
            <Icon name="description" size={32} />
          </span>
          <p class="max-w-xs font-body text-body-sm text-text-muted-dark">{t.common.documentPending}</p>
        </div>
      )
    }
    <span class="absolute end-3 top-3 inline-flex items-center gap-1 rounded-full border border-secondary-fixed/40 bg-dark-brown-surface/90 px-3 py-1 font-label text-label-badge uppercase text-secondary-fixed backdrop-blur">
      <Icon name="check_circle" size={14} />
      {tl(doc.badge, lang)}
    </span>
  </div>

  <div class="flex flex-1 flex-col justify-between p-space-lg sm:p-space-xl">
    <div>
      <div class="mb-space-md border-b border-secondary-fixed/20 pb-space-md">
        <span class="font-label text-label-badge uppercase text-secondary-fixed">{tl(doc.authority, lang)}</span>
        <h3 class="mt-1 font-display text-headline-sm text-surface-bright">{title}</h3>
      </div>
      <dl class="mb-space-lg space-y-space-sm font-body text-body-sm text-surface-variant">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <dt class="font-label text-label-badge uppercase text-text-muted-sand">{tl(doc.referenceLabel, lang)}</dt>
          <dd class="font-semibold text-surface-bright" dir={doc.id === 'noc-letter' ? 'ltr' : undefined}>{tl(doc.reference, lang)}</dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.common.sanctionDate}</dt>
          <dd class="font-semibold text-secondary-fixed">{formatDate(doc.date, lang)}</dd>
        </div>
      </dl>
      <p class="border-t border-secondary-fixed/15 pt-space-sm font-body text-body-sm text-surface-variant">{tl(doc.description, lang)}</p>
      {
        detailed && (
          <div class="mt-space-md rounded-lg border border-secondary-fixed/20 bg-dark-brown-surface/60 p-space-md">
            <p class="mb-1 flex items-center gap-1.5 font-label text-label-badge uppercase text-secondary-fixed">
              <Icon name="gavel" size={16} />
              {t.common.legalRelevance}
            </p>
            <p class="font-body text-body-sm text-surface-variant">{tl(doc.legal, lang)}</p>
          </div>
        )
      }
    </div>
    {
      doc.image && full && (
        <div class="mt-space-lg flex items-center justify-end border-t border-secondary-fixed/20 pt-space-md">
          <button
            type="button"
            class="inline-flex min-h-11 items-center gap-1.5 font-label text-label-badge uppercase text-secondary-fixed transition-colors hover:text-surface-bright"
            data-pswp-open={doc.id}
          >
            <Icon name="visibility" size={16} />
            {t.common.inspectDocument}
          </button>
        </div>
      )
    }
  </div>
</article>
