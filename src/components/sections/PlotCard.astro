---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import type { Plot } from '../../data/plots';
import { formatNumber } from '../../data/plots';
import { fmt, getDict, routeHref, tl } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  plot: Plot;
  lang: Lang;
}
const { plot, lang } = Astro.props;
const t = getDict(lang);
const label = tl(plot.label, lang);
const marlaText = Number.isInteger(plot.marla) ? plot.marla.toFixed(1) : String(plot.marla);
---

<article
  class:list={[
    'group relative flex h-full flex-col justify-between overflow-hidden rounded-2xl bg-surface-cream-card shadow-sm transition-shadow duration-500 will-change-transform hover:shadow-lift',
    plot.featured ? 'border border-secondary/40 shadow-md' : 'border border-border-sand-medium/70',
  ]}
  data-tilt
  data-reveal
>
  {
    plot.featured && (
      <div class="absolute end-0 top-0 rounded-es-lg bg-secondary px-4 py-1 font-label text-label-badge uppercase text-surface-bright">
        {t.common.premierAddress}
      </div>
    )
  }
  <div class="p-space-lg">
    <div class:list={['mb-space-md flex items-center justify-between gap-2', plot.featured && 'mt-5']}>
      <Badge tone={plot.badgeTone}>{tl(plot.badge, lang)}</Badge>
      <span class="whitespace-nowrap font-label text-label-eyebrow font-semibold text-secondary" dir="ltr">
        {plot.dimensions} ft
      </span>
    </div>
    <h3 class="font-display text-headline-md text-on-surface transition-colors group-hover:text-secondary">{label}</h3>
    <p class="mt-2 mb-space-md min-h-[40px] font-body text-body-sm text-on-surface-variant">{tl(plot.description, lang)}</p>

    <dl class="grid grid-cols-3 gap-2 rounded-lg border-y border-border-sand-light bg-surface-container/50 py-space-sm text-center">
      <div class="flex flex-col-reverse">
        <dt class="font-label text-label-badge uppercase text-text-muted-dark">{t.common.area}<span class="block text-[10px] font-medium">{t.common.sqftLong}</span></dt>
        <dd class="font-display text-headline-sm text-on-surface" dir="ltr">{formatNumber(plot.sqft)}</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="font-label text-label-badge uppercase text-text-muted-dark">{t.common.marla}<span class="block text-[10px] font-medium">{t.common.units}</span></dt>
        <dd class="font-display text-headline-sm text-on-surface" dir="ltr">{marlaText}</dd>
      </div>
      <div class="flex flex-col-reverse">
        <dt class="font-label text-label-badge uppercase text-text-muted-dark">{t.common.kanal}<span class="block text-[10px] font-medium">{plot.kanal === 1 ? t.common.fullEstate : t.common.fraction}</span></dt>
        <dd class="font-display text-headline-sm text-on-surface" dir="ltr">{plot.kanal.toFixed(2)}</dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border-sand-light/50 px-space-lg pt-space-sm pb-space-lg">
    <div>
      <span class="block font-label text-label-badge uppercase text-text-muted-dark">{t.common.pricing}</span>
      <span class="font-display text-headline-sm text-secondary">{t.common.priceOnInquiry}</span>
    </div>
    <a
      href={routeHref('contact', lang)}
      data-inquiry={plot.value}
      class="btn-fill inline-flex min-h-11 items-center gap-1.5 rounded-lg bg-terracotta px-space-md py-2.5 font-label text-label-badge uppercase text-white shadow-sm transition-shadow [--btn-fill:var(--color-terracotta-hover)] hover:shadow-lg"
    >
      {fmt(t.common.inquirePlot, { size: label })}
      <Icon name="arrow_forward" size={16} flip />
    </a>
  </div>
</article>
