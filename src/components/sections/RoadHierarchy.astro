---
/** Road hierarchy infographic — Stitch road cards + animated width bars scaled to 100 ft. */
import { getDict } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<ol class="grid grid-cols-1 gap-space-lg md:grid-cols-3 md:gap-space-xl">
  {
    t.roads.map((r, i) => (
      <li
        class:list={[
          'relative overflow-hidden rounded-xl bg-surface-cream-card p-space-lg shadow-sm',
          i === 0 ? 'border border-secondary-fixed-dim/60' : 'border border-border-sand-medium/40',
        ]}
        data-reveal
      >
        <p class:list={['mb-1 font-display text-stat-value', i === 0 ? 'text-secondary' : 'text-on-surface']} dir="ltr">
          {r.width}
        </p>
        <h3 class="font-display text-headline-sm text-on-surface">{r.title}</h3>
        <p class="mt-2 font-body text-body-sm text-on-surface-variant">{r.text}</p>
        <div class="mt-space-md" aria-hidden="true">
          <div class="h-2 w-full overflow-hidden rounded-full bg-surface-container-highest">
            <div
              class:list={['h-full origin-left rounded-full rtl:origin-right', i === 0 ? 'bg-secondary' : 'bg-gold-antique-light']}
              style={`width:${r.count}%`}
              data-bar
            />
          </div>
        </div>
        <p
          class:list={[
            'mt-4 border-t border-border-sand-light pt-4 font-label text-label-badge uppercase',
            i === 0 ? 'text-secondary' : 'text-text-muted-dark',
          ]}
        >
          {r.tag}
        </p>
      </li>
    ))
  }
</ol>
