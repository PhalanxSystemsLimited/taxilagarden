---
import { site } from '../../data/site';
import { getDict } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = '' } = Astro.props;
const t = getDict(lang);
const f = site.facts;
const ur = lang === 'ur';

type Stat = { label: string; gold: boolean; count?: number; suffix?: string; text?: string };
const stats: Stat[] = [
  { count: f.area.kanal, suffix: ur ? ` کنال ${f.area.marla} مرلہ` : ` K ${f.area.marla} M`, label: t.stats.land, gold: true },
  { text: t.stats.nocValue, label: t.stats.noc, gold: false },
];
---

<div
  class:list={[
    'w-full max-w-xl rounded-xl border border-secondary-fixed/20 bg-dark-brown-surface/80 p-space-md shadow-2xl backdrop-blur-xl sm:p-space-lg',
    className,
  ]}
  data-hero-fade
>
  <dl class="grid grid-cols-2 divide-x divide-secondary-fixed/15 rtl:divide-x-reverse">
    {
      stats.map((s) => (
        <div class="flex flex-col-reverse items-center p-2 text-center">
          <dt class="mt-1 font-label text-label-eyebrow uppercase text-surface-variant">{s.label}</dt>
          <dd class:list={['font-display text-[26px] leading-tight sm:text-stat-value', s.gold ? 'text-secondary-fixed' : 'text-surface-bright']} dir={ur ? 'rtl' : 'ltr'}>
            {
              s.count !== undefined ? (
                <>
                  <span data-count={s.count} class="tabular-nums">{s.count}</span>
                  {s.suffix && <span class="text-[0.6em]">{s.suffix}</span>}
                </>
              ) : (
                <span class="text-[0.8em] rtl:text-[0.62em]">{s.text}</span>
              )
            }
          </dd>
        </div>
      ))
    }
  </dl>
</div>
