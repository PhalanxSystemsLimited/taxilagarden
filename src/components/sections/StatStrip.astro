---
import { site } from '../../data/site';
import { getDict, formatDate } from '../../lib/i18n';
import type { Lang } from '../../data/types';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = '' } = Astro.props;
const t = getDict(lang);
const approval = formatDate(site.facts.layoutApprovalDate, lang, true);
const approvalPrefix = approval.replace(/\s*2016$/, '');

const stats = [
  { value: site.facts.landKanal, decimals: 2, label: t.stats.land, gold: true, grouping: true },
  { value: site.facts.plots, decimals: 0, label: t.stats.plots, gold: false, grouping: true },
  { value: 2016, decimals: 0, prefix: approvalPrefix, label: t.stats.approved, gold: true, grouping: false },
  { value: site.facts.mainBoulevardFt, decimals: 0, suffix: lang === 'ur' ? ' فٹ' : ' ft', label: t.stats.boulevard, gold: false, grouping: true },
];
---

<div
  class:list={[
    'w-full max-w-5xl rounded-xl border border-secondary-fixed/20 bg-dark-brown-surface/80 p-space-md shadow-2xl backdrop-blur-xl sm:p-space-lg',
    className,
  ]}
  data-hero-fade
>
  <dl class="grid grid-cols-2 gap-y-4 md:grid-cols-4 md:divide-x md:divide-secondary-fixed/15 rtl:md:divide-x-reverse">
    {
      stats.map((s, i) => (
        <div class:list={['flex flex-col-reverse items-center p-2 text-center', i >= 2 && 'border-t border-secondary-fixed/15 pt-4 md:border-t-0 md:pt-2']}>
          <dt class="mt-1 font-label text-label-eyebrow uppercase text-surface-variant">{s.label}</dt>
          <dd class:list={['font-display text-[26px] leading-tight sm:text-stat-value', s.gold ? 'text-secondary-fixed' : 'text-surface-bright']} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
            {s.prefix && <span>{s.prefix} </span>}
            <span data-count={s.value} data-decimals={s.decimals} data-grouping={String(s.grouping)} class="tabular-nums">
              {s.value.toLocaleString('en-US', { minimumFractionDigits: s.decimals, maximumFractionDigits: s.decimals, useGrouping: s.grouping })}
            </span>
            {s.suffix && <span>{s.suffix}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
