---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RoadHierarchy from '../components/sections/RoadHierarchy.astro';
import BlockList from '../components/sections/BlockList.astro';
import CTABand from '../components/sections/CTABand.astro';
import MasterPlanViewer from '../components/react/MasterPlanViewer.jsx';
import { approvals } from '../data/approvals';
import { navLabels } from '../data/navigation';
import { site } from '../data/site';
import { fullImage } from '../lib/images';
import { formatDate, getDict, routeHref, tl } from '../lib/i18n';
import plan from '../assets/images/master-layout-plan.jpg';
import type { Lang } from '../data/types';

const lang: Lang = Astro.currentLocale === 'ur' ? 'ur' : 'en';
const t = getDict(lang);
const m = t.masterPlan;
const doc = approvals.find((d) => d.id === 'master-layout')!;

const viewer = await getImage({ src: plan, widths: [1200, 2000, 3200], format: 'webp', quality: 72 });
const full = await fullImage(plan);

/** Download button only renders when a PDF has been added to /public. */
const pdfPath = '';

const legendIcons: Record<string, string> = {
  residential: 'home',
  commercial: 'storefront',
  green: 'park',
  mosque: 'mosque',
  roads: 'add_road',
};
---

<BaseLayout title={m.seoTitle} description={m.seoDescription}>
  <PageHero lang={lang} eyebrow={m.eyebrow} title={m.title} sub={m.sub} crumb={tl(navLabels.masterPlan, lang)} />

  <section class="container-x py-space-2xl" aria-label={m.viewerLabel}>
    <div class="grid grid-cols-1 gap-space-xl lg:grid-cols-12">
      <div class="lg:col-span-8" data-reveal>
        <div class="rounded-2xl border border-border-sand-medium bg-surface-cream-card p-space-sm shadow-tier2">
          <MasterPlanViewer
            client:visible
            src={viewer.src}
            srcSet={viewer.srcSet.attribute}
            width={plan.width}
            height={plan.height}
            alt={tl(doc.imageAlt, lang)}
            fullSrc={full.src}
            strings={{ label: m.viewerLabel, hint: m.viewerHint, zoomIn: m.zoomIn, zoomOut: m.zoomOut, reset: m.reset, fullRes: m.fullRes }}
          />
        </div>
      </div>

      <aside class="space-y-space-lg lg:col-span-4">
        <div class="rounded-2xl border border-secondary-fixed/30 bg-dark-brown-surface p-space-lg text-surface-bright shadow-xl" data-reveal>
          <p class="font-label text-label-badge uppercase text-secondary-fixed">{tl(doc.authority, lang)}</p>
          <h2 class="mt-1 font-display text-headline-sm">{tl(doc.title, lang)}</h2>
          <dl class="mt-space-md grid grid-cols-2 gap-space-md border-t border-secondary-fixed/20 pt-space-md">
            <div>
              <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.common.kanal}</dt>
              <dd class="font-display text-stat-value text-secondary-fixed" dir="ltr"><span data-count={site.facts.landKanal} data-decimals="2">{site.facts.landKanal}</span></dd>
            </div>
            <div>
              <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.stats.plots}</dt>
              <dd class="font-display text-stat-value text-surface-bright" dir="ltr"><span data-count={site.facts.plots}>{site.facts.plots}</span></dd>
            </div>
            <div class="col-span-2">
              <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.common.sanctionDate}</dt>
              <dd class="font-body text-body-md font-semibold text-secondary-fixed">{formatDate(doc.date, lang)} · {t.stats.approved}</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-border-sand-medium/60 bg-surface-cream-card p-space-lg" data-reveal>
          <h2 class="eyebrow mb-space-md">{m.legendTitle}</h2>
          <ul class="space-y-2">
            {
              m.legend.map((l) => (
                <li class="flex items-center gap-3 font-body text-body-sm text-on-surface">
                  <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-cream-highlight text-secondary">
                    <Icon name={legendIcons[l.key] ?? 'circle'} size={20} />
                  </span>
                  {l.label}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-dashed border-border-sand-medium bg-surface-cream-highlight/50 p-space-lg" data-reveal>
          <p class="flex items-center gap-2 font-display text-headline-sm text-on-surface">
            <Icon name="gavel" size={22} class="text-secondary" />
            {m.allotmentTitle}
          </p>
          <p class="mt-2 font-body text-body-sm text-on-surface-variant">{m.allotment}</p>
          <div class="mt-space-md flex flex-wrap gap-2">
            <Button variant="primary" size="sm" href={routeHref('contact', lang)} inquiry="General Inquiry">{t.common.inquire}</Button>
            {pdfPath && <Button variant="outline" size="sm" href={pdfPath} icon="download" download>{m.download}</Button>}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-border-sand-light bg-surface-container py-space-2xl md:py-space-3xl" aria-labelledby="roads-title">
    <div class="container-x">
      <SectionHeading eyebrow={m.roadsEyebrow} title={m.roadsTitle} sub={m.roadsSub} align="center" id="roads-title" class="mb-space-2xl" />
      <RoadHierarchy lang={lang} />
    </div>
  </section>

  <section class="container-x py-space-2xl md:py-space-3xl" aria-labelledby="blocks-title">
    <SectionHeading eyebrow={m.blocksEyebrow} title={m.blocksTitle} id="blocks-title" class="mb-space-xl" />
    <BlockList lang={lang} />
  </section>

  <CTABand lang={lang} />
</BaseLayout>
