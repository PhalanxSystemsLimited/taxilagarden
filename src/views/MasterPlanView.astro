---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import CTABand from '../components/sections/CTABand.astro';
import MasterPlanViewer from '../components/react/MasterPlanViewer.jsx';
import { approvals } from '../data/approvals';
import { navLabels } from '../data/navigation';
import { areaText } from '../data/site';
import { fullImage } from '../lib/images';
import { getDict, routeHref, tl } from '../lib/i18n';
import plan from '../assets/images/master-layout-plan.jpg';
import type { Lang } from '../data/types';

const lang: Lang = Astro.currentLocale === 'ur' ? 'ur' : 'en';
const t = getDict(lang);
const m = t.masterPlan;
const doc = approvals.find((d) => d.id === 'master-layout')!;

const viewer = await getImage({ src: plan, widths: [1200, 2000, 3200], format: 'webp', quality: 72 });
const full = await fullImage(plan);

/** Download button only renders when a PDF has been added to /public. */
const pdfPath = '';
---

<BaseLayout title={m.seoTitle} description={m.seoDescription}>
  <PageHero lang={lang} eyebrow={m.eyebrow} title={m.title} sub={m.sub} crumb={tl(navLabels.masterPlan, lang)} />

  <section class="container-x py-space-2xl" aria-label={m.viewerLabel}>
    <div class="grid grid-cols-1 gap-space-xl lg:grid-cols-12">
      <div class="lg:col-span-8" data-reveal>
        <div class="rounded-2xl border border-border-sand-medium bg-surface-cream-card p-space-sm shadow-tier2">
          <MasterPlanViewer
            client:visible
            src={viewer.src}
            srcSet={viewer.srcSet.attribute}
            width={plan.width}
            height={plan.height}
            alt={tl(doc.imageAlt, lang)}
            fullSrc={full.src}
            strings={{ label: m.viewerLabel, hint: m.viewerHint, zoomIn: m.zoomIn, zoomOut: m.zoomOut, reset: m.reset, fullRes: m.fullRes }}
          />
        </div>
      </div>

      <aside class="space-y-space-lg lg:col-span-4">
        <div class="rounded-2xl border border-secondary-fixed/30 bg-dark-brown-surface p-space-lg text-surface-bright shadow-xl" data-reveal>
          <p class="font-label text-label-badge uppercase text-secondary-fixed">{tl(doc.authority, lang)}</p>
          <h2 class="mt-1 font-display text-headline-sm">{tl(doc.title, lang)}</h2>
          <dl class="mt-space-md grid grid-cols-2 gap-space-md border-t border-secondary-fixed/20 pt-space-md">
            <div class="col-span-2">
              <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.stats.land}</dt>
              <dd class="font-display text-headline-md text-secondary-fixed">{areaText(lang)}</dd>
            </div>
            <div class="col-span-2">
              <dt class="font-label text-label-badge uppercase text-text-muted-sand">{t.common.authority}</dt>
              <dd class="font-body text-body-md font-semibold text-secondary-fixed">{t.stats.nocValue} · {t.stats.noc}</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-dashed border-border-sand-medium bg-surface-cream-highlight/50 p-space-lg" data-reveal>
          <p class="flex items-center gap-2 font-display text-headline-sm text-on-surface">
            <Icon name="gavel" size={22} class="text-secondary" />
            {m.allotmentTitle}
          </p>
          <p class="mt-2 font-body text-body-sm text-on-surface-variant">{m.allotment}</p>
          <div class="mt-space-md flex flex-wrap gap-2">
            <Button variant="primary" size="sm" href={routeHref('contact', lang)} inquiry="General Inquiry">{t.common.inquire}</Button>
            {pdfPath && <Button variant="outline" size="sm" href={pdfPath} icon="download" download>{m.download}</Button>}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CTABand lang={lang} />
</BaseLayout>
