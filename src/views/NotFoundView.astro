---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getDict, routeHref } from '../lib/i18n';
import type { Lang } from '../data/types';

const lang: Lang = Astro.currentLocale === 'ur' ? 'ur' : 'en';
const t = getDict(lang);
const n = t.notFound;
---

<BaseLayout title={n.seoTitle} noindex>
  <section class="relative isolate flex min-h-[85vh] items-center overflow-hidden bg-primary-container pt-[168px] pb-24 text-surface-bright" data-hero>
    <svg class="absolute inset-0 -z-10 h-full w-full text-gold-antique-light opacity-10" preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
      <path d="M0,0 C30,40 70,60 100,100 M100,0 C70,40 30,60 0,100" fill="none" stroke="currentColor" stroke-width="0.3"></path>
    </svg>
    <p class="pointer-events-none absolute inset-x-0 top-1/2 -z-10 -translate-y-1/2 text-center font-display text-[38vw] leading-none text-white/[0.03] select-none" aria-hidden="true" dir="ltr">404</p>
    <div class="container-x text-center">
      <p class="eyebrow eyebrow-center mb-3 justify-center text-secondary-fixed" data-hero-fade>{n.eyebrow}</p>
      <h1 class="mx-auto max-w-3xl font-display text-headline-display-mobile text-balance md:text-headline-display" data-split data-hero-title>{n.title}</h1>
      <p class="mx-auto mt-space-md max-w-xl font-body text-body-lead text-surface-variant" data-hero-rise>{n.sub}</p>
      <div class="mt-space-xl flex flex-col items-stretch justify-center gap-space-sm sm:flex-row sm:items-center" data-hero-fade>
        <Button variant="primary" size="lg" href={routeHref('home', lang)} icon="home">{n.home}</Button>
        <Button variant="heritage" size="lg" href={routeHref('plots', lang)}>{t.common.viewPlotCategories}</Button>
        <Button variant="whatsapp" size="lg" href={routeHref('contact', lang)}>{t.common.bookSiteVisit}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
