---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Badge from '../components/ui/Badge.astro';
import PlotCard from '../components/sections/PlotCard.astro';
import PlotCompareTable from '../components/sections/PlotCompareTable.astro';
import CTABand from '../components/sections/CTABand.astro';
import { plots } from '../data/plots';
import { navLabels } from '../data/navigation';
import { getDict, tl } from '../lib/i18n';
import type { Lang } from '../data/types';

const lang: Lang = Astro.currentLocale === 'ur' ? 'ur' : 'en';
const t = getDict(lang);
const p = t.plots;
---

<BaseLayout title={p.seoTitle} description={p.seoDescription}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.title} sub={p.sub} crumb={tl(navLabels.plots, lang)} />

  <section class="container-x pt-space-2xl pb-space-2xl md:pb-space-3xl" aria-labelledby="plot-list-title">
    <div class="mb-space-lg flex flex-wrap items-center justify-between gap-3">
      <h2 id="plot-list-title" class="eyebrow" data-reveal="eyebrow">{p.listLabel}</h2>
      <Badge tone="seal" icon="verified">{p.listCount}</Badge>
    </div>

    <ul class="grid grid-cols-1 gap-space-lg md:grid-cols-2 lg:grid-cols-3 lg:gap-space-xl">
      {plots.map((plot) => <li><PlotCard plot={plot} lang={lang} /></li>)}
    </ul>
  </section>

  <section class="border-t border-border-sand-light bg-surface-container-low py-space-2xl md:py-space-3xl" aria-labelledby="compare-title">
    <div class="container-x">
      <SectionHeading eyebrow={p.compareEyebrow} title={p.compareTitle} id="compare-title" class="mb-space-xl" />
      <PlotCompareTable lang={lang} />
    </div>
  </section>

  <CTABand lang={lang} eyebrow={t.cta.eyebrow} title={t.cta.title} text={t.cta.text} button={t.common.bookSiteVisit} />
</BaseLayout>
